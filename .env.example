# Hospital AI OS — environment
#
# Everything here is optional. With no .env at all the app runs on a local
# SQLite file, local disk storage and the built-in voice simulator.

# Where the SQLite database and local recordings live (default: ./.data)
# DATA_DIR=/var/lib/hospital-ai-os

# Override just the database file
# DATABASE_FILE=/var/lib/hospital-ai-os/hospital-ai-os.db

# Voice provider keys are NOT set here — each hospital enters its own keys in
# Settings → Voice providers, and they are stored per tenant in the database so
# one deployment can serve many hospitals with different accounts.

# ── Rate limits ──────────────────────────────────────────────────────────
# The defaults are the safe ones and suit a public sign-up page. Raise them
# only deliberately — e.g. a single hospital whose whole staff shares one
# outbound address, or a test environment that creates many tenants.
# RATE_LIMIT_LOGIN_PER_ACCOUNT=8     # failed sign-ins per email / 15 min
# RATE_LIMIT_LOGIN_PER_IP=30         # sign-in attempts per address / 15 min
# RATE_LIMIT_SIGNUP_PER_IP=5         # new hospitals per address / hour
# RATE_LIMIT_WEBHOOK_PER_IP=120      # voice webhook posts per address / min

# ── Demo data ────────────────────────────────────────────────────────────
# Demo hospitals seed automatically in development. In production they are
# OFF unless you ask for them, because they include a platform super-admin
# whose password the login screen prints.
# SEED_DEMO=1

# ── Cookies ──────────────────────────────────────────────────────────────
# Session cookies are marked Secure in production. Set this ONLY for a
# deliberate plain-HTTP deployment on a trusted internal network.
# ALLOW_INSECURE_COOKIES=1

# ── Encryption at rest ───────────────────────────────────────────────────
# When set, call recordings and export bundles are encrypted with AES-256-GCM
# before they are written to local disk. Generate one with:
#     openssl rand -hex 32
# Keep it OUT of the database and OUT of version control, and keep a copy
# somewhere safe — without it, encrypted recordings cannot be recovered.
# This does NOT encrypt the patient database; that needs an encrypted volume.
# STORAGE_ENCRYPTION_KEY=
